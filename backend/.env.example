# Server
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL / Standard PostgreSQL)
DATABASE_URL=

# S3-Compatible Cloud Storage (Supabase Storage for Development / S3-Compatible)
# Note: AWS S3 is NOT required. Supabase Storage S3-compatible API is the initial provider.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# Expiry & Upload Limits (Supabase Free plan limit: 50MB)
DEFAULT_LINK_EXPIRY_HOURS=24
MIN_LINK_EXPIRY_HOURS=1
MAX_LINK_EXPIRY_HOURS=168
MAX_UPLOAD_SIZE_MB=50

# Client & Public URLs
CLIENT_URL=http://localhost:5173
PUBLIC_SHARE_BASE_URL=http://localhost:5173
