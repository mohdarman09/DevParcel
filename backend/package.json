{
  "name": "devparcel-backend",
  "version": "0.1.0",
  "description": "DevParcel backend service for secure temporary project sharing",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/**/*.test.js",
    "test:ts": "npm run build && node --test dist/test/**/*.test.js",
    "cleanup": "tsx src/scripts/runCleanup.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.714.0",
    "@aws-sdk/lib-storage": "^3.714.0",
    "@aws-sdk/s3-request-presigner": "^3.714.0",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
